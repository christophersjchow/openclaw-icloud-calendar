{
  "name": "openclaw-icloud-calendar",
  "version": "0.2.0",
  "description": "OpenClaw plugin for iCloud Calendar over CalDAV with email invitations and safe recurring-instance overrides.",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5",
      "minGatewayVersion": "2026.6.5"
    },
    "install": {
      "minHostVersion": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "files": [
    "dist/",
    "marketplace.json",
    "openclaw.plugin.json",
    "skills/",
    "src/"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "icloud",
    "apple",
    "calendar",
    "caldav"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophersjchow/openclaw-icloud-calendar.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openclaw": "^2026.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "ICLOUD_INTEGRATION=1 vitest run test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  }
}
